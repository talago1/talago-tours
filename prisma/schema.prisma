generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
  directUrl = env("DIRECT_URL")
}

enum BookingStatus {
  PENDING
  CONFIRMED
  COMPLETED
  CANCELLED
}

enum ReviewStatus {
  PENDING
  APPROVED
  REJECTED
}

enum BookingChannel {
  VIATOR
  GETYOURGUIDE
  WHATSAPP
  HOTEL_DIRECT
  WEBSITE
}

enum DiscountType {
  PERCENTAGE
  FIXED_AMOUNT
}

model PromoCode {
  id              String       @id @default(uuid())
  code            String       @unique
  discountType    DiscountType
  discountValue   Decimal
  currency        String       @default("EGP")
  minBookingValue Decimal       @default(0)
  maxUses         Int
  usedCount       Int          @default(0)
  expiresAt       DateTime
  isActive        Boolean      @default(true)
  createdAt       DateTime     @default(now())
  updatedAt       DateTime     @updatedAt

  bookings Booking[]

  @@index([code, isActive])
}

enum TourType {
  SHARED
  PRIVATE
}

model Destination {
  id          String   @id @default(cuid())
  name        String
  slug        String   @unique
  description String?  @db.Text
  imageUrl    String?
  translations Json    @default("{}")
  countryCode String   @default("EG")
  region      String?
  city        String?
  latitude    Float?
  longitude   Float?
  timezone    String   @default("Africa/Cairo")
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  tours Tour[]
  zones Zone[]

  @@index([slug])
}

model Zone {
  id           String   @id @default(cuid())
  name         String   @unique
  transferFee  Float    @default(0)
  pickupOffset Float?
  destinationId String?
  location     String?
  pickupWindow String?
  instructions String?
  isActive     Boolean  @default(true)
  createdAt    DateTime @default(now())

  destination Destination? @relation(fields: [destinationId], references: [id])
  tours     Tour[]
  bookings  Booking[]
}

model Tour {
  id           String   @id @default(cuid())
  slug         String   @unique
  type         TourType
  basePriceUSD Float
  basePrice    Float?
  durationHours  Int
  duration     String?
  maxCapacity    Int
  zoneId         String
  destinationId  String?
  translations   Json

  // Global Location Overrides
  countryCode String?
  region      String?
  city        String?
  latitude    Float?
  longitude   Float?
  timezone    String?

  // Media
  coverImage    String?
  galleryImages String[]
  thumbnailUrl  String?

  // Marketing & Value Points
  highlights String[]
  inclusions String[]
  exclusions String[]
  category   String?
  status     String?

  // Marketing Badges
  isFeatured      Boolean @default(false)
  isBestSeller    Boolean @default(false)
  isRecommended   Boolean @default(false)
  isVip           Boolean @default(false)
  isFamilyFriendly Boolean @default(false)
  isNew           Boolean @default(false)
  customBadge     String?
  secondaryCategories String[] @default([])
  tags            String[] @default([])

  // Ratings
  ratingAverage Float @default(0)
  ratingCount   Int   @default(0)

  // Payment Policy
  allowDeposit       Boolean @default(false)
  depositPercentage  Int     @default(0)
  depositType        String  @default("PERCENTAGE") // 'PERCENTAGE' | 'FIXED'
  depositAmount      Float?                           // fixed-amount deposit in USD (used when depositType = 'FIXED')
  allowPayAtLocation Boolean @default(false)
  // Catalog Display
  showExcerptOnCard Boolean @default(true)
  cardExcerpt       String?
  displayExcerpt    Boolean @default(false)

  // Logistics & Operations
  itinerary                 Json?
  whatToBring               String?
  pickupDescription         String?
  hotelPickupIncluded       Boolean  @default(false)
  pickupTime                String?
  pickupTimes               String[]
  pickupType                String   @default("hotel") // hotel, meeting_point, airport, port, station, private_address, none
  meetingPointName          String?
  meetingPointAddress       String?
  meetingPointLat           Float?
  meetingPointLng           Float?
  meetingPointLandmark      String?
  meetingPointInstructions  String?
  meetingPointMapUrl        String?
  meetingPointImageUrl      String?
  cancellationPolicy        String?

  // Detailed Pricing Tiers
  adultPrice Float
  priceAdult Float?
  originalPrice Float?

  childPrice  Float?
  priceChild  Float?
  childMinAge Int?   @default(3)
  childMaxAge Int?   @default(11)

  infantPrice  Float?
  infantMinAge Int?  @default(0)
  infantMaxAge Int?  @default(2)
  pricePrivate Float?

  ageRestrictionsNotes String?

  // Transport & Fleet
  vehicleType         String?
  boatType            String?
  airConditioned      Boolean @default(false)
  transferNotes       String?

  // Fitness & Accessibility
  fitnessLevel        String?
  wheelchairAccessible Boolean @default(false)
  strollerAccessible   Boolean @default(false)
  mobilityNotes        String?
  accessibilityNotes   String?

  // Safety & Insurance
  safetyGuidelines    String[] @default([])
  insuranceIncluded    Boolean @default(true)
  emergencyContact     String?
  freeCancellationHours Int @default(24)

  // Scheduling
  instantConfirmation Boolean @default(true)
  cutoffHours         Int @default(12)
  durationDisplay     String?

  // Route & Activities
  routeStops    Json?
  activityTypes String[] @default([])

  // Operator & Internal
  operatorName   String?
  operatorPhone  String?
  operatorEmail  String?
  internalNotes  String?

  // Tour Variants
  variants    Json?

  // SEO & Metadata
  metaTitle       String?
  metaDescription String?
  keywords        String[] @default([])

  // Analytics & Reporting
  costPerPerson Decimal?

  // Tour Add-ons / Options (JSON array of { id, price, priceType, enabled, labels })
  tourOptions Json?
  // Dynamic Booking Questions (Phase 8: JSON array of { id, question, type, required, options })
  bookingQuestions Json?

  // Legacy
  images    String[]
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  zone       Zone       @relation(fields: [zoneId], references: [id])
  destination Destination? @relation(fields: [destinationId], references: [id])

  bookings      Booking[]
  mediaAssets   MediaAsset[]
  reviews       Json?
  tourTimeSlots TourTimeSlot[]
  reviewEntries Review[]
}

model Booking {
  id               String        @id @default(uuid())
  bookingReference String        @unique
  // Secret capability for customer-facing booking access. 256-bit CSPRNG value,
  // independent of bookingReference. bookingReference is human-readable and is
  // NOT a credential; this is.
  accessToken      String        @unique
  tourId           String
  zoneId           String
  hotelName        String?
  travelDate       DateTime
  guestCount       Int
  adultsCount      Int     @default(0)
  childrenCount    Int     @default(0)
  infantsCount     Int     @default(0)
  totalPriceUSD    Float
  customerName     String
  customerEmail    String
  customerPhone    String
  language         String        @default("en")
  status           BookingStatus @default(PENDING)
  paymentStatus      String?
  paymentGatewayLogs Json     @default("[]")

  isCheckedIn  Boolean    @default(false)
  checkedInAt  DateTime?
  checkInLog   Json       @default("[]")

  channel          BookingChannel @default(WEBSITE)

  roomNumber          String?
  pickupDirectives    String?
  pickupType          String?  // HOTEL, MEETING_POINT, AIRPORT, PORT, STATION, PRIVATE_ADDRESS, NONE
  pickupLocationName  String?  // Hotel name, Airport terminal, Meeting point name, etc.
  pickupAddress       String?
  flightNumbers       String?
  bedConfiguration String?
  bedConfig        String?
  specialRequirements String?
  // Phase 8: Add-ons & Booking Questions
  selectedAddons      Json?    // [{ id, title, price, priceType, quantity }]
  bookingAnswers      Json?    // { [questionId]: answer } or [{ questionId, question, answer }]

  promoCodeId      String?
  promoCode        PromoCode?    @relation(fields: [promoCodeId], references: [id], onDelete: SetNull)

  // Payment fields
  paymentScheme    String?
  amountPaidOnline Float?
  amountDueOnArrival Float?

  // Scheduling
  timeSlotId          String?
  selectedPickupTime  String?

  // Customer profile link
  customerProfileId String?

  // Currency
  currency String @default("USD")

  // WhatsApp opt-in
  whatsappOptIn Boolean @default(false)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  tour Tour @relation(fields: [tourId], references: [id])
  zone Zone @relation(fields: [zoneId], references: [id])

  transaction Transaction?
  reviews Review[]

  @@index([tourId])
  @@index([bookingReference])
  @@index([tourId, travelDate, status])
  @@index([travelDate, status])
  @@index([status, createdAt])
  @@index([channel])
  @@index([promoCodeId])
}

model Review {
  id           String       @id @default(cuid())
  tourId       String
  bookingId    String?      @unique
  customerName String
  rating       Int
  comment      String?
  status       ReviewStatus @default(PENDING)
  createdAt    DateTime     @default(now())
  updatedAt    DateTime     @updatedAt

  tour    Tour     @relation(fields: [tourId], references: [id])
  booking Booking? @relation(fields: [bookingId], references: [id], onDelete: SetNull)

  @@index([tourId])
  @@index([status])
  @@map("reviews")
}

model Transaction {
  id               String  @id @default(cuid())
  bookingId        String  @unique
  provider         String
  gatewayReference String?
  amountPaidOnline  Float
  amountDueOnArrival Float  @default(0)
  scheme           String?
  status           String?
  createdAt        DateTime @default(now())
  updatedAt        DateTime @updatedAt

  booking Booking @relation(fields: [bookingId], references: [id], onDelete: Cascade)

  @@index([bookingId])
}


model CustomerProfile {
  id               String    @id @default(cuid())
  email            String    @unique
  name             String
  phone            String?
  isShadow         Boolean   @default(false)
  invitedAt        DateTime?
  lastMagicLinkAt  DateTime?
  createdAt        DateTime  @default(now())
  updatedAt        DateTime  @updatedAt

  @@index([email])
}

model TourTimeSlot {
  id                String  @id @default(cuid())
  tourId            String
  label             String
  maxCapacityPerSlot Int
  createdAt         DateTime @default(now())

  tour Tour @relation(fields: [tourId], references: [id], onDelete: Cascade)

  @@index([tourId])
}

model NotificationLog {
  id           String   @id @default(cuid())
  bookingId    String
  channel      String
  recipient    String
  status       String
  errorMessage String?
  messageId    String?
  sentAt       DateTime @default(now())
  createdAt    DateTime @default(now())

  @@index([bookingId])
}

model SystemSetting {
  key   String @id
  value String

  @@map("system_settings")
}

model MediaAsset {
  id           String   @id @default(cuid())
  filename     String
  filePath     String
  displayOrder Int      @default(0)
  mimeType     String
  tourId       String
  tour         Tour     @relation(fields: [tourId], references: [id], onDelete: Cascade)
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  @@index([tourId])
}

model NewsletterSubscription {
  id        String   @id @default(uuid())
  email     String   @unique
  locale    String   @default("en")
  subscribedAt DateTime @default(now())
  isActive  Boolean  @default(true)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@map("newsletter_subscriptions")
}

// ─── Spec 013: Crew, Fleet & Expense ────────────────────────────────────────

enum CrewRole {
  CAPTAIN
  GUIDE
  DRIVER
}

enum FleetType {
  BOAT
  SPEEDBOAT
  VEHICLE
  QUAD
}

enum ExpenseCategory {
  FUEL
  CREW_PAYROLL
  CATERING
  PERMITS
  MISC
}

enum ExpenseCurrency {
  USD
  EGP
}

model CrewMember {
  id        String   @id @default(cuid())
  name      String
  role      CrewRole
  phone     String?
  isActive  Boolean  @default(true)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  assignments CrewAssignment[]

  @@index([role, isActive])
  @@map("crew_members")
}

model FleetAsset {
  id        String    @id @default(cuid())
  name      String
  type      FleetType
  capacity  Int?
  isActive  Boolean   @default(true)
  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt

  assignments FleetAssignment[]

  @@index([type, isActive])
  @@map("fleet_assets")
}

model CrewAssignment {
  id            String   @id @default(cuid())
  crewMemberId  String
  tourId        String
  departureDate String   // YYYY-MM-DD

  createdAt DateTime @default(now())

  crewMember CrewMember @relation(fields: [crewMemberId], references: [id], onDelete: Cascade)

  @@index([departureDate, tourId])
  @@index([crewMemberId, departureDate])
  @@map("crew_assignments")
}

model FleetAssignment {
  id            String   @id @default(cuid())
  fleetAssetId  String
  tourId        String
  departureDate String   // YYYY-MM-DD

  createdAt DateTime @default(now())

  fleetAsset FleetAsset @relation(fields: [fleetAssetId], references: [id], onDelete: Cascade)

  @@index([departureDate, tourId])
  @@index([fleetAssetId, departureDate])
  @@map("fleet_assignments")
}

model TripExpense {
  id                 String          @id @default(cuid())
  departureDateGroup String          // YYYY-MM-DD
  tourId             String
  category           ExpenseCategory
  amount             Decimal         @db.Decimal(10, 2)
  currency           ExpenseCurrency
  notes              String?
  createdAt          DateTime        @default(now())

  @@index([departureDateGroup, tourId])
  @@map("trip_expenses")
}


model BlogPost {
  id              String   @id @default(cuid())
  slug            String   @unique
  title           String
  excerpt         String?  @db.Text
  content         String   @db.Text
  coverImage      String?
  category        String   @default("Travel Guide")
  tags            String[] @default([])
  authorName      String   @default("TALAGO Editorial")
  authorAvatar    String?
  readTimeMinutes Int      @default(5)
  isPublished     Boolean  @default(true)
  isFeatured      Boolean  @default(false)
  viewsCount      Int      @default(0)
  translations    Json     @default("{}")
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  @@index([slug, isPublished])
  @@index([category, isPublished])
  @@map("blog_posts")
}
