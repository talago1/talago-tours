generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
  directUrl = env("DIRECT_URL")
}

enum BookingStatus {
  PENDING
  CONFIRMED
  COMPLETED
  CANCELLED
}

enum ReviewStatus {
  PENDING
  APPROVED
  REJECTED
}

enum BookingChannel {
  VIATOR
  GETYOURGUIDE
  WHATSAPP
  HOTEL_DIRECT
  WEBSITE
}

enum DiscountType {
  PERCENTAGE
  FIXED_AMOUNT
}

model PromoCode {
  id              String       @id @default(uuid())
  code            String       @unique
  discountType    DiscountType
  discountValue   Decimal
  currency        String       @default("EGP")
  minBookingValue Decimal       @default(0)
  maxUses         Int
  usedCount       Int          @default(0)
  expiresAt       DateTime
  isActive        Boolean      @default(true)
  createdAt       DateTime     @default(now())
  updatedAt       DateTime     @updatedAt

  bookings Booking[]

  @@index([code, isActive])
}

enum TourType {
  SHARED
  PRIVATE
}

model Destination {
  id          String   @id @default(cuid())
  name        String
  slug        String   @unique
  description String?  @db.Text
  imageUrl    String?
  translations Json    @default("{}")
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  tours Tour[]
  zones Zone[]

  @@index([slug])
}

model Zone {
  id          String   @id @default(cuid())
  name        String   @unique
  transferFee Float    @default(0)
  pickupOffset Float?
  destinationId String?
  createdAt   DateTime @default(now())

  destination Destination? @relation(fields: [destinationId], references: [id])
  tours     Tour[]
  bookings  Booking[]
}

model Tour {
  id           String   @id @default(cuid())
  slug         String   @unique
  type         TourType
  basePriceUSD Float
  basePrice    Float?
  durationHours  Int
  duration     String?
  maxCapacity    Int
  zoneId         String
  destinationId  String?
  translations   Json

  // Media
  coverImage    String?
  galleryImages String[]
  thumbnailUrl  String?

  // Marketing & Value Points
  highlights String[]
  inclusions String[]
  exclusions String[]
  category   String?
  status     String?

  // Ratings
  ratingAverage Float @default(0)
  ratingCount   Int   @default(0)

  // Payment Policy
  allowDeposit       Boolean @default(false)
  depositPercentage  Int     @default(0)
  allowPayAtLocation Boolean @default(false)

  // Logistics & Operations
  itinerary           Json?
  whatToBring         String?
  pickupDescription   String?
  hotelPickupIncluded Boolean  @default(false)

  // Detailed Pricing Tiers
  adultPrice Float

  childPrice  Float?
  childMinAge Int?   @default(3)
  childMaxAge Int?   @default(11)

  infantPrice  Float?
  infantMinAge Int?  @default(0)
  infantMaxAge Int?  @default(2)

  ageRestrictionsNotes String?

  // Analytics & Reporting
  costPerPerson Decimal?

  // Legacy
  images    String[]
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  zone       Zone       @relation(fields: [zoneId], references: [id])
  destination Destination? @relation(fields: [destinationId], references: [id])

  bookings      Booking[]
  mediaAssets   MediaAsset[]
  reviews       Review[]
  tourTimeSlots TourTimeSlot[]
}

model Booking {
  id               String        @id @default(uuid())
  bookingReference String        @unique
  tourId           String
  zoneId           String
  hotelName        String
  travelDate       DateTime
  guestCount       Int
  totalPriceUSD    Float
  customerName     String
  customerEmail    String
  customerPhone    String
  language         String        @default("en")
  status           BookingStatus @default(PENDING)
  paymentStatus      String?
  paymentGatewayLogs Json     @default("[]")

  isCheckedIn  Boolean    @default(false)
  checkedInAt  DateTime?
  checkInLog   Json       @default("[]")

  channel          BookingChannel @default(WEBSITE)

  roomNumber       String?

  promoCodeId      String?
  promoCode        PromoCode?    @relation(fields: [promoCodeId], references: [id], onDelete: SetNull)

  // Payment fields
  paymentScheme    String?
  amountPaidOnline Float?
  amountDueOnArrival Float?

  // Scheduling
  timeSlotId       String?

  // Customer profile link
  customerProfileId String?

  // WhatsApp opt-in
  whatsappOptIn Boolean @default(false)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  tour Tour @relation(fields: [tourId], references: [id])
  zone Zone @relation(fields: [zoneId], references: [id])

  transaction Transaction?

  @@index([tourId])
  @@index([bookingReference])
}

model Transaction {
  id               String  @id @default(cuid())
  bookingId        String  @unique
  provider         String
  gatewayReference String?
  amountPaidOnline  Float
  amountDueOnArrival Float  @default(0)
  scheme           String?
  status           String?
  createdAt        DateTime @default(now())
  updatedAt        DateTime @updatedAt

  booking Booking @relation(fields: [bookingId], references: [id], onDelete: Cascade)

  @@index([bookingId])
}

model Review {
  id           String       @id @default(cuid())
  tourId       String
  customerName String
  rating       Int
  comment      String?
  status       ReviewStatus @default(PENDING)
  createdAt    DateTime     @default(now())
  updatedAt    DateTime     @updatedAt

  tour Tour @relation(fields: [tourId], references: [id], onDelete: Cascade)

  @@index([tourId])
  @@index([status])
}

model CustomerProfile {
  id               String    @id @default(cuid())
  email            String    @unique
  name             String
  phone            String?
  isShadow         Boolean   @default(false)
  invitedAt        DateTime?
  lastMagicLinkAt  DateTime?
  createdAt        DateTime  @default(now())
  updatedAt        DateTime  @updatedAt

  @@index([email])
}

model TourTimeSlot {
  id                String  @id @default(cuid())
  tourId            String
  label             String
  maxCapacityPerSlot Int
  createdAt         DateTime @default(now())

  tour Tour @relation(fields: [tourId], references: [id], onDelete: Cascade)

  @@index([tourId])
}

model NotificationLog {
  id           String   @id @default(cuid())
  bookingId    String
  channel      String
  recipient    String
  status       String
  errorMessage String?
  messageId    String?
  sentAt       DateTime @default(now())
  createdAt    DateTime @default(now())

  @@index([bookingId])
}

model SystemSetting {
  key   String @id
  value Json

  @@map("system_settings")
}

model MediaAsset {
  id           String   @id @default(cuid())
  filename     String
  filePath     String
  displayOrder Int      @default(0)
  mimeType     String
  tourId       String
  tour         Tour     @relation(fields: [tourId], references: [id], onDelete: Cascade)
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  @@index([tourId])
}
