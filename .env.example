# -----------------------------------------------------------------------------
# TALAGO Tours — Environment Configuration Template
# Copy this file to .env or .env.local and configure values accordingly.
# -----------------------------------------------------------------------------

# --- Database (PostgreSQL / Supabase / Neon) ---
DATABASE_URL="postgresql://user:password@localhost:5432/talago?schema=public"
DIRECT_URL="postgresql://user:password@localhost:5432/talago?schema=public"

# --- Public App Configuration ---
NEXT_PUBLIC_APP_URL="http://localhost:3000"
NEXT_PUBLIC_BASE_URL="http://localhost:3000"
NEXT_PUBLIC_SITE_URL="http://localhost:3000"

# --- Supabase Storage & Client ---
NEXT_PUBLIC_SUPABASE_URL="https://your-project.supabase.co"
NEXT_PUBLIC_SUPABASE_ANON_KEY="your-anon-key"
SUPABASE_SERVICE_ROLE_KEY="your-service-role-key"

# --- Admin Authentication & Security ---
ADMIN_API_TOKEN="generate-a-secure-random-token-for-admin-session"
QR_HMAC_SECRET="generate-a-secure-random-secret-for-boarding-pass-hmac"

# --- Google Gemini AI (Tour Auto-Translation & SEO Blog Writer) ---
GEMINI_API_KEY="your-google-gemini-api-key"

# --- Email Notifications (Resend) ---
RESEND_API_KEY="re_your_resend_api_key"
RESEND_FROM_EMAIL="Talago Tours <booking@talago-tours.com>"
CONTACT_EMAIL="info@talago-tours.com"

# --- WhatsApp Notifications (Green API - Optional) ---
GREEN_API_ID=""
GREEN_API_TOKEN=""

# --- Telegram Customer Login (OIDC — from BotFather OIDC setup) ---
# Step 1: BotFather → /mybots → @talagoo_bot → Bot Settings → Login Widget → Switch to OpenID Connect
# Step 2: Add Allowed Callback URL: https://talago-tours.vercel.app/api/auth/telegram/oidc-callback
# Step 3: Copy the numeric Client ID and Client Secret below
TELEGRAM_OIDC_CLIENT_ID=""          # Numeric bot ID from BotFather OIDC setup
TELEGRAM_OIDC_CLIENT_SECRET=""      # Client secret from BotFather OIDC setup

# --- Telegram Admin Alerts (Telegram Bot API - for admin notifications) ---
TELEGRAM_BOT_TOKEN=""
TELEGRAM_ADMIN_CHAT_ID=""

# --- Cron Security (Abandoned Checkout Recovery Endpoint) ---
CRON_SECRET=""

# --- Paymob Payment Gateway (Optional / When enabled) ---
PAYMOB_API_KEY=""
PAYMOB_INTEGRATION_ID=""
PAYMOB_HMAC_SECRET=""

# --- Analytics (Optional) ---
NEXT_PUBLIC_GA_ID=""
NEXT_PUBLIC_META_PIXEL_ID=""
